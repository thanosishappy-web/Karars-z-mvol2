# Supabase PostgreSQL bağlantı URL'i
# Format: postgresql://postgres.[proje-ref]:[sifre]@aws-0-[bolge].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:sifre@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Django Secret Key (rastgele uzun bir string)
SECRET_KEY=buraya-cok-gizli-bir-key-yaz

# Debug modu (development: True, production: False)
DEBUG=True

# İzin verilen hostlar (virgülle ayır)
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
